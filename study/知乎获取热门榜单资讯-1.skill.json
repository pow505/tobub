    "name": "知乎获取热门榜单资讯",
    "skill_version": "1",
    "source_type": "local",
    "skill_code": "let records = [];\n\nawait tobub.atoms.navigate({ url: \"https://www.zhihu.com/hot\" , waitUntil: 'domcontentloaded' })\n\nawait tobub.atoms.waitFor([500, 1500]);\n\nconst list = await tobub.adapter.extract(\"search\", { scan: { mode: \"append\" } });\n\nfor (const record of list.records) {\n  records.push(record);\n  const fields = record.fields ?? {};\n  const externalId = String(record.id || fields.id || \"\");\n  if (!externalId) continue;\n  await tobub.db.saveContent({\n    platform: \"zhihu\",\n    contentType: \"article\",\n    externalId,\n    title: fields.title ?? externalId,\n    summary: fields.intro ?? \"\",\n    url: fields.link,\n    metadata: {\n      thumb: fields.thumb ?? \"\",\n      title: fields.title ?? \"\",\n      hot: fields.hot ?? \"\",\n      intro: fields.intro ?? \"\"\n    },\n    rawData: fields\n  });\n}\n\nreturn records;\n\n",
