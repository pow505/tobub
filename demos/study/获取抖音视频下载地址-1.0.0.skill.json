  "skill": {
    "market_skill_id": "douyin-get-download-address",
    "release_id": "local-tests-20260906",
    "name": "获取抖音视频下载地址",
    "skill_version": "1.0.0",
    "source_type": "local",
    "skill_code": "const awemeId = String(tobub.params.awemeId)\n\nconst watch = await tobub.browser.network.watch({\n  id: 'douyin-aweme-detail',\n  urlPattern: 'aweme/v1/web/aweme/detail',\n  methods: ['GET'],\n  captureResponseBody: true,\n  maxRecords: 10,\n})\nawait tobub.atoms.navigate({\n  url: 'https://www.douyin.com/video/' + awemeId,\n  waitUntil: 'domcontentloaded',\n})\n\nawait tobub.atoms.waitFor(3000)\nconst networkRecords = await tobub.browser.network.collect(watch)\nconst captured = networkRecords.find(\n  (item) => item.response && typeof item.response.body === 'string',\n)\nif (\n  !captured ||\n  !captured.response ||\n  typeof captured.response.body !== 'string'\n) throw new Error('未捕获到抖音 aweme 详情响应')\n\nconst payload = JSON.parse(captured.response.body)\nconst rawData = { ...payload }\ndelete rawData.aweme_detail\nconst awemeDetail = payload.aweme_detail ?? {}\nconst video = awemeDetail.video ?? {}\nconst playAddr = video.play_addr ?? {}\nconst downloadUrls = Array.isArray(playAddr.url_list) ? playAddr.url_list : []\nconst download1 = typeof downloadUrls[0] === 'string' ? downloadUrls[0] : ''\nconst download2 = typeof downloadUrls[1] === 'string' ? downloadUrls[1] : ''\nconst download3 = typeof downloadUrls[2] === 'string' ? downloadUrls[2] : ''\nconst title =\n  typeof awemeDetail.desc === 'string' && awemeDetail.desc\n    ? awemeDetail.desc\n    : '抖音视频 ' + awemeId\nawait tobub.db.saveContent({\n  platform: 'douyin',\n  contentType: 'video',\n  externalId: awemeId,\n  title,\n  url: 'https://www.douyin.com/video/' + awemeId,\n  metadata: {\n    downloadUrls,\n    download1,\n    download2,\n    download3,\n    responseUrl: captured.request.url,\n  },\n  rawData,\n})\nreturn {\n  awemeId,\n  downloadUrls,\n  download1,\n  download2,\n  download3,\n  responseUrl: captured.request.url,\n}\n",
    "platform": "douyin",
