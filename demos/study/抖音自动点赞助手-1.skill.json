  "skill": {
    "market_skill_id": "local_75045bc4-8816-4aeb-9e19-e0aee108cddc",
    "release_id": "local_75045bc4-8816-4aeb-9e19-e0aee108cddc",
    "name": "抖音自动点赞助手",
    "skill_version": "1",
    "source_type": "local",
    "skill_code": "//注意：不要比例太高，避免被风控\nconst vid = String(tobub.params.vid);\nconst probability = Number(tobub.params.probability) / 100;\n\nif (!Number.isFinite(probability) || probability < 0 || probability > 1) {\n  throw new Error(\"probability 必须是 0 到 100 之间的数字\");\n}\n\nconst commentLikeSelector =\n  'div[data-scroll=\"comment\"] p:has(> svg + span)';\n\nconst records = [];\nlet checkedCount = 0;\nlet likedCount = 0;\n\n// 每次运行使用独立的记录键，避免复用上次运行的抽样结果。\nconst runKey = `${vid}-${Date.now()}-${Math.random()}`;\n\nasync function getVisibleUnlikedIndices() {\n  const result = await tobub.atoms.evaluate({\n    expression: `({ selector, runKey }) => {\n      const store =\n        window.__tobubLikeSeenByRun ??=\n        new Map();\n\n      let seen = store.get(runKey);\n      if (!seen) {\n        seen = new WeakSet();\n        store.set(runKey, seen);\n      }\n\n      const items = [...document.querySelectorAll(selector)];\n      const width = window.innerWidth;\n      const height = window.innerHeight;\n      const indices = [];\n\n      items.forEach((el, index) => {\n        const rect = el.getBoundingClientRect();\n        const path = el.querySelector(\"svg path\");\n\n        const visible =\n          el.getClientRects().length > 0 &&\n          getComputedStyle(el).visibility !== \"hidden\" &&\n          rect.bottom > 0 &&\n          rect.top < height &&\n          rect.right > 0 &&\n          rect.left < width;\n\n        const unliked = path?.getAttribute(\"fill\") === \"#fff\";\n\n        // 同一 DOM 元素只参与一次概率抽样。\n        if (!visible || !unliked || seen.has(el)) return;\n\n        seen.add(el);\n        indices.push(index);\n      });\n\n      return indices;\n    }`,\n    arg: {\n      selector: commentLikeSelector,\n      runKey\n    }\n  });\n\n  return Array.isArray(result.value) ? result.value : [];\n}\n\nasync function likeVisibleComments() {\n  const indices = await getVisibleUnlikedIndices();\n\n  // 倒序处理，降低点击改变 DOM 后索引偏移的影响。\n  for (let i = indices.length - 1; i >= 0; i--) {\n    const nth = indices[i];\n    const shouldLike = tobub.utils.chance(probability);\n\n    const record = {\n      sequence: ++checkedCount,\n      domIndex: nth,\n      decision: shouldLike ? \"like\" : \"skip\",\n      clicked: false\n    };\n    records.push(record);\n\n    if (!shouldLike) continue;\n\n    try {\n      await tobub.atoms.click({\n        selector: commentLikeSelector,\n        nth,\n        visibleOnly: true,\n        where: {\n          selector: \"svg path\",\n          source: \"attr\",\n          attr: \"fill\",\n          equals: \"#fff\"\n        }\n      });\n\n      record.clicked = true;\n      likedCount++;\n      await tobub.atoms.waitFor([100, 250]);\n    } catch (error) {\n      if (String(error).includes(\"No matching clickable element found\")) {\n        // 页面更新导致目标失效时，跳过这项并继续处理其他项。\n        continue;\n      }\n      throw error;\n    }\n  }\n}\n\nawait tobub.adapter.navigate({\n  url: \"https://www.douyin.com/video/\" + vid,\n  waitUntil: \"domcontentloaded\"\n});\n\nawait tobub.atoms.waitFor(\n  {\n    selector: 'div[data-scroll=\"comment\"]',\n    selectorState: \"attached\"\n  },\n  { timeout: 15000 }\n);\n\nawait tobub.adapter.dismissPopups();\nawait tobub.atoms.waitFor([3000, 6000]);\n\nfor (let i = 0; i < 999; i++) {\n  if (tobub.utils.chance(0.5)) {\n    await tobub.atoms.scroll({\n      mode: \"viewport\",\n      distance: tobub.utils.randInt(390, 1200),\n      steps: tobub.utils.randInt(3, 15),\n      stepPauseRange: [10, 25]\n    });\n  } else {\n    await tobub.atoms.scroll({\n      mode: \"viewport\",\n      distance: 500,\n      steps: 1,\n      stepPauseRange: [10, 25]\n    });\n  }\n\n  await tobub.atoms.waitFor([800, 2000]);\n\n  // 每条未点赞评论分别抽样，不再对整屏做一次概率判断。\n  await likeVisibleComments();\n\n  const endCheck = await tobub.atoms.condition(\n    {\n      conditions: [\n        { type: \"visible\", selector: 'text=\"暂时没有更多评论\"' },\n        {\n          type: \"inViewport\",\n          selector: 'text=\"暂时没有更多评论\"',\n          intersection: \"partial\"\n        }\n      ],\n      mode: \"all\",\n      throwOnTimeout: false\n    },\n    { timeout: 2000 }\n  );\n  if (endCheck.satisfied) break;\n}\n\nreturn {\n  videoId: vid,\n  checkedCount,\n  likedCount,\n  records\n};",
