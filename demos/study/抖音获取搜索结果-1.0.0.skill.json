  "skill": {
    "market_skill_id": "douyin-search-videos",
    "release_id": "local-tests-20260906",
    "name": "抖音获取搜索结果",
    "skill_version": "1.0.0",
    "source_type": "local",
    "skill_code": "const searchKey = String(tobub.params.searchKey);\nconst count = Number(tobub.params.count);\nconst records = [];\nlet scans = 0;\nawait tobub.atoms.navigate({ url: \"https://www.douyin.com/search/\" + encodeURIComponent(searchKey) + \"?type=general\", waitUntil: \"domcontentloaded\" });\nawait tobub.atoms.waitFor({ title: \"抖音搜索\", titleMatch: \"contains\" }, { timeout: 15000 });\nawait tobub.adapter.dismissPopups();\nawait tobub.atoms.waitFor([3000, 6000]);\nawait tobub.atoms.click({ selector: 'div#search-toolbar-container div:text-is(\"多列\")' });\n\nfor (let i = 0; i < 999 ; i++) {\n  scans++;\n  await tobub.atoms.waitFor([1000, 2600]);\n  await tobub.atoms.scroll({ mode: \"viewport\", distance: tobub.utils.randInt(390, 1200), steps: tobub.utils.randInt(3, 15), stepPauseRange: [10, 25] });\n  const videoList = await tobub.adapter.extract(\"search_videos\", { scan: { mode: \"append\" } });\n  for (const record of videoList.records) {\n    if (records.length >= count) break;\n    const fields = record.fields ?? {};\n    const externalId = String(record.id || fields.vid || \"\");\n    if (!externalId) continue;\n    await tobub.db.saveContent({\n      platform: \"douyin\",\n      contentType: \"video\",\n      externalId,\n      title: fields.intro ?? \"抖音视频 \" + externalId,\n      summary: fields.author ?? \"\",\n      url: \"https://www.douyin.com/video/\" + externalId,\n      metadata: {\n        thumb: fields.thumb ?? \"\",\n        duration: fields.duration ?? \"\",\n        like: fields.like ?? \"\",\n        author: fields.author ?? \"\",\n        time: fields.time ?? \"\"\n      },\n      rawData: fields\n    });\n    records.push(record);\n  }\n  if (records.length >= count) break;\n}\nreturn { query: searchKey, records, scans };",
    "platform": "douyin",
