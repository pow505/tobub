    "name": "YoutubeCommentScraping",
    "source_type": "local",
    "skill_code": "await tobub.adapter.navigate({ name: 'video' });\nawait tobub.adapter.action('pageReady');\n\nlet totalCount = 0;\nconst times = tobub.utils.randInt(1,3) + tobub.params.times;\nlet noNewDataLimit = 6;\n\nfor (let i = 0; i < times; i++) {\n  const result = await tobub.adapter.extract('comments');\n  totalCount += result.newCount;\n\n  for (const record of result.records) {\n    console.log(\n      `[comment] ${record.fields.name?.trim()}(${record.fields.time?.trim()})-${record.fields.likes?.trim()}: ${record.fields.comment}`,\n    );\n  }\n\n  if (result.scannedCount === 0) {\n    if (noNewDataLimit > 0) {\n      noNewDataLimit--;\n    } else {\n      break;\n    }\n  } else {\n    noNewDataLimit = 6;\n  }\n\n  await tobub.adapter.action('scrollComments');\n}",
    "platform": "youtube",
    "input_schema": {
      "type": "object",
      "properties": {
        "times": {
          "title": "times",
          "type": "number"
        }
      },
      "additionalProperties": true
    },
    "output_schema": {},
    "ui_schema": {
