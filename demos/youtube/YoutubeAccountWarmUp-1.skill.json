    "name": "YoutubeAccountWarmUp",
    "source_type": "local",
    "skill_code": "const durationMinutes = tobub.params.minutes ?? 5;\nconst deadline = Date.now() + durationMinutes * 60 * 1000;\n\nawait tobub.adapter.bootstrap();\n\nawait tobub.adapter.action('pageReady');\n\nfor (let i = 0; i < 999; i++) {\n  const roll = Math.random();\n\n  if (roll < 0.2) {\n    await tobub.adapter.navigate({ name: 'home' });\n\n    const rawSelector = await tobub.adapter.getSelector('homeNotEmpty');\n    const selector = Array.isArray(rawSelector) ? rawSelector[0] : rawSelector;\n\n    try {\n      await tobub.atoms.waitFor({ selector, selectorState: 'attached' });\n      await tobub.adapter.action('homeWarmup');\n    } catch {    }\n  } else {\n    await tobub.adapter.navigate({ name: 'shorts' });\n\n    const shortTimes = tobub.params.times;\n    for (let i = 0; i < 999; i++) {\n      await tobub.adapter.action('waitShortsReady');\n      await tobub.adapter.action('watchShort');\n      if(tobub.utils.chance(0.05)) break;\n      if(Date.now() > deadline) break;\n    }\n  }\n  if(Date.now() > deadline) break;\n}",
    "platform": "youtube",
