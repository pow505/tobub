  "rule": {
    "platform": "youtube",
    "version": "1.0.0",
    "schema_version": "1",
    "hash": "0f7f97ffdc603469c164cc02e5f1abe17f368fedb656681ca6dd63f3ade62b6b",
    "rules": {
      "actions": {
        "commentsInteraction": {
          "steps": [
            {
              "atom": "click",
              "onFailure": {
                "policy": "continue"
              },
              "options": {
                "selector": "${selectors.commentsButton}"
              },
              "timeout": 1500,
              "when": {
                "selector": "${selectors.commentsButton}",
                "state": "visible"
              }
            },
            {
              "atom": "waitFor",
              "options": {
                "delay": [
                  1500,
                  4000
                ]
              }
            }
          ]
        },
        "homeScroll": {
          "steps": [
            {
              "atom": "scroll",
              "options": {
                "distance": [
                  700,
                  1200
                ],
                "mode": "mouse",
                "stepPauseRange": [
                  10,
                  25
                ],
                "steps": [
                  8,
                  15
                ],
                "target": "${selectors.homeContainer}"
              }
            },
            {
              "atom": "waitFor",
              "options": {
                "delay": [
                  3000,
                  10000
                ]
              }
            }
          ]
        },
        "homeWarmup": {
          "steps": [
            {
              "action": "homeScroll",
              "repeat": {
                "max": 12,
                "min": 5
              }
            }
          ]
        },
        "pageReady": {
          "steps": [
            {
              "atom": "waitFor",
              "options": {
                "title": "YouTube",
                "titleMatch": "contains"
              },
              "timeout": 10000
            },
            {
              "atom": "waitFor",
              "options": {
                "delay": [
                  2000,
                  3500
                ]
              }
            }
          ]
        },
        "shortsComments": {
          "steps": [
            {
              "action": "commentsInteraction",
              "probability": 0.5,
              "when": {
                "selector": "${selectors.commentsButton}",
                "state": "visible"
              }
            }
          ]
        },
        "shortsLike": {
          "steps": [
            {
              "atom": "click",
              "onFailure": {
                "policy": "continue"
              },
              "options": {
                "selector": "${selectors.likeButton}"
              },
              "probability": 0.05,
              "timeout": 1500,
              "when": {
                "selector": "${selectors.likeButton}",
                "state": "visible"
              }
            }
          ]
        },
        "shortsScroll": {
          "steps": [
            {
              "atom": "scroll",
              "options": {
                "distance": [
                  500,
                  1100
                ],
                "mode": "mouse",
                "steps": [
                  1,
                  3
                ],
                "target": "${selectors.shortsContainer}"
              }
            },
            {
              "atom": "waitFor",
              "options": {
                "delay": [
                  3000,
                  5000
                ]
              }
            }
          ]
        },
        "waitShortsReady": {
          "steps": [
            {
              "atom": "waitFor",
              "options": {
                "delay": [
                  2000,
                  3500
                ],
                "selector": "${selectors.shortsVideo}",
                "selectorState": "visible"
              },
              "timeout": 10000
            }
          ]
        },
        "watchShort": {
          "steps": [
            {
              "action": "shortsScroll"
            },
            {
              "atom": "waitFor",
              "options": {
                "delay": [
                  30000,
                  50000
                ]
              },
              "probability": 0.05
            },
            {
              "action": "shortsLike"
            },
            {
              "action": "shortsComments"
            }
          ]
        }
      },
