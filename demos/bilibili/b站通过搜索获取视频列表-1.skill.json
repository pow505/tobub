    "name": "BilibiligetVideoByKey",
    "skill_version": "1",
    "source_type": "local",
    "skill_code": "const key = String(tobub.params.key);\nconst count = Number(tobub.params.count);\n\nconst stepCount = 30;\nconst records = [];\nlet scans = 0;\n\nfor (let i = 0; i < 999 ; i++) {\n  scans++;\n  let url = 'https://search.bilibili.com/all?from_source=web_search&keyword='+key+'&order=pubdate'\n  if (i > 0) url = url + '&page='+(i+1)+'&o='+stepCount*(i);\n  await tobub.atoms.navigate({ url: url, waitUntil: 'domcontentloaded' });\n  await tobub.atoms.waitFor([500, 1500]);\n  const list = await tobub.adapter.extract(\"search\", {\n    scan: { mode: \"rescan\" },\n    reset: i === 0\n  });\n  for (const record of list.records) {\n    if (records.length >= count) break;\n    records.push(record);\n    const fields = record.fields ?? {};\n    const externalId = String(record.id || fields.id || \"\");\n    if (!externalId) continue;\n    await tobub.db.saveContent({\n      platform: \"bilibili\",\n      contentType: \"video\",\n      externalId,\n      title: fields.title ?? externalId,\n      summary: fields.author ?? \"\",\n      url: \"https:\" + fields.link,\n      metadata: {\n        thumb: fields.thumb ? \"https:\" + fields.thumb : \"\",\n        title: fields.title ?? \"\",\n        play: fields.play ?? \"\",\n        author: fields.author ?? \"\",\n        time: fields.time ?? \"\"\n      },\n      rawData: fields\n    });\n  }\n  if (records.length >= count) break;\n}\n\nreturn records;",
    "platform": "bilibili",
