  "skill": {
    "market_skill_id": "douyin-get-download-address",
    "release_id": "douyin-get-download-address-1.0.2",
    "name": "获取抖音视频下载地址",
    "skill_version": "1.0.2",
    "source_type": "local",
    "skill_code": "const params = tobub.params || {};\nfunction normalizeVideoId(input) {\n  const value = String(input ?? \"\").trim();\n  if (!value) throw new Error(\"awemeId 不能为空\");\n  let candidate = value;\n  if (/^https?:\\/\\//i.test(value)) {\n    let parsed;\n    try { parsed = new URL(value); } catch { throw new Error(\"awemeId 不是有效的视频 ID 或 URL\"); }\n    if (!/(^|\\.)douyin\\.com$/i.test(parsed.hostname)) throw new Error(\"视频 URL 必须来自 douyin.com\");\n    const match = parsed.pathname.match(/\\/video\\/(\\d+)/);\n    if (!match) throw new Error(\"视频 URL 中没有有效的视频 ID\");\n    candidate = match[1];\n  }\n  if (!/^\\d{8,30}$/.test(candidate)) throw new Error(\"视频 ID 必须是 8 到 30 位数字\");\n  return candidate;\n}\nconst awemeId = normalizeVideoId(params.awemeId);\nconst responseWaitMs = Number(params.responseWaitMs ?? 15_000);\nconst saveResults = params.saveResults !== false;\nif (!Number.isInteger(responseWaitMs) || responseWaitMs < 1_000 || responseWaitMs > 30_000) throw new Error(\"responseWaitMs 必须是 1000 到 30000 的整数\");\nconst watch = await tobub.browser.network.watch({ id: \"douyin-aweme-detail\", urlPattern: \"aweme/v1/web/aweme/detail\", methods: [\"GET\"], captureResponseBody: true, maxBodyBytes: 4_000_000, maxRecords: 20 });\nlet watchActive = true;\ntry {\n  const videoUrl = \"https://www.douyin.com/video/\" + awemeId;\n  await tobub.atoms.navigate({ url: videoUrl, waitUntil: \"domcontentloaded\" });\n  await tobub.atoms.waitFor({ delay: responseWaitMs });\n  const networkRecords = await tobub.browser.network.collect(watch, { stop: true });\n  watchActive = false;\n  let captured = null;\n  let payload = null;\n  for (const item of networkRecords ?? []) {\n    const body = item?.response?.body;\n    if (typeof body !== \"string\") continue;\n    let candidate;\n    try { candidate = JSON.parse(body); } catch { continue; }\n    const detail = candidate?.aweme_detail;\n    const returnedId = String(detail?.aweme_id ?? detail?.awemeId ?? \"\");\n    if (returnedId && returnedId !== awemeId) continue;\n    if (!detail) continue;\n    captured = item;\n    payload = candidate;\n    break;\n  }\n  if (!captured || !payload) throw new Error(\"在等待时间内未捕获到与该视频 ID 匹配的 aweme 详情响应\");\n  const rawData = { ...payload };\n  delete rawData.aweme_detail;\n  const awemeDetail = payload.aweme_detail ?? {};\n  const video = awemeDetail.video ?? {};\n  const playAddr = video.play_addr ?? video.play_addr_h264 ?? {};\n  const downloadUrls = Array.isArray(playAddr.url_list) ? playAddr.url_list.filter((url) => typeof url === \"string\" && /^https?:\\/\\//i.test(url)) : [];\n  if (downloadUrls.length === 0) throw new Error(\"已捕获详情响应，但其中没有可用的播放地址\");\n  const download1 = downloadUrls[0] ?? \"\";\n  const download2 = downloadUrls[1] ?? \"\";\n  const download3 = downloadUrls[2] ?? \"\";\n  const title = typeof awemeDetail.desc === \"string\" && awemeDetail.desc.trim() ? awemeDetail.desc.trim() : \"抖音视频 \" + awemeId;\n  if (saveResults) {\n    await tobub.db.saveContent({ platform: \"douyin\", contentType: \"video\", externalId: awemeId, title, url: \"https://www.douyin.com/video/\" + awemeId, metadata: { downloadUrls, download1, download2, download3, responseUrl: captured.request?.url ?? \"\" }, rawData });\n  }\n  return { awemeId, title, downloadUrls, download1, download2, download3, responseUrl: captured.request?.url ?? \"\", saved: saveResults };\n} finally {\n  if (watchActive) await tobub.browser.network.stop(watch).catch(() => undefined);\n}",
    "platform": "douyin",
