    "source_type": "local",
    "skill_code": "const params = tobub.params || {};\nfunction normalizeVideoId(input) {\n  const value = String(input ?? \"\").trim();\n  if (!value) throw new Error(\"vid 不能为空\");\n  let candidate = value;\n  if (/^https?:\\/\\//i.test(value)) {\n    let parsed;\n    try { parsed = new URL(value); } catch { throw new Error(\"vid 不是有效的视频 ID 或 URL\"); }\n    if (!/(^|\\.)douyin\\.com$/i.test(parsed.hostname)) throw new Error(\"视频 URL 必须来自 douyin.com\");\n    const match = parsed.pathname.match(/\\/video\\/(\\d+)/);\n    if (!match) throw new Error(\"视频 URL 中没有有效的视频 ID\");\n    candidate = match[1];\n  }\n  if (!/^\\d{8,30}$/.test(candidate)) throw new Error(\"视频 ID 必须是 8 到 30 位数字\");\n  return candidate;\n}\nconst vid = normalizeVideoId(params.vid);\nconst count = Number(params.count ?? 15);\nconst maxScrollTimes = Number(params.maxScrollTimes ?? 30);\nconst saveResults = params.saveResults !== false;\nif (!Number.isInteger(count) || count < 1 || count > 100) throw new Error(\"count 必须是 1 到 100 的整数\");\nif (!Number.isInteger(maxScrollTimes) || maxScrollTimes < 1 || maxScrollTimes > 100) throw new Error(\"maxScrollTimes 必须是 1 到 100 的整数\");\nconst records = [];\nconst seenKeys = new Set();\nlet scans = 0;\nlet savedCount = 0;\nlet noProgressScans = 0;\nlet stopReason = \"maxScrollTimes\";\nconst videoUrl = \"https://www.douyin.com/video/\" + vid;\nconst videoContent = saveResults ? await tobub.db.saveContent({ platform: \"douyin\", contentType: \"video\", externalId: vid, title: \"抖音视频 \" + vid, url: videoUrl, rawData: { videoId: vid } }) : null;\nawait tobub.adapter.navigate({ url: videoUrl, waitUntil: \"domcontentloaded\" });\nawait tobub.atoms.waitFor({ selector: 'div[data-scroll=\"comment\"]', selectorState: \"attached\" }, { timeout: 20_000 });\nawait tobub.adapter.dismissPopups();\nawait tobub.atoms.waitFor([2000, 4000]);\nfunction stableHash(value) {\n  let hash = 1469598103934665603n;\n  for (const character of value) hash = BigInt.asUintN(64, (hash ^ BigInt(character.codePointAt(0))) * 1099511628211n);\n  return hash.toString(16).padStart(16, \"0\");\n}\nfor (let i = 0; i < maxScrollTimes && records.length < count; i++) {\n  scans++;\n  const postList = await tobub.adapter.extract(\"content_comment_list\", { scan: { mode: \"append\" } });\n  let added = 0;\n  for (const record of postList?.records ?? []) {\n    if (records.length >= count) break;\n    const fields = record.fields ?? {};\n    const comment = String(fields.comment ?? \"\").trim();\n    if (!comment) continue;\n    const commenterId = String(fields.userUuid ?? record.id ?? fields.userNickname ?? \"unknown\");\n    const time = String(fields.time ?? \"\").trim();\n    const stableSourceKey = JSON.stringify([commenterId, comment, time]);\n    if (seenKeys.has(stableSourceKey)) continue;\n    seenKeys.add(stableSourceKey);\n    const externalId = vid + \":\" + stableHash(stableSourceKey);\n    const normalizedRecord = { id: externalId, fields };\n    records.push(normalizedRecord);\n    added++;\n    if (saveResults) {\n      await tobub.db.saveContent({\n        platform: \"douyin\",\n        contentType: \"comment\",\n        externalId,\n        parentId: videoContent?.contentItemId,\n        title: comment,\n        summary: fields.userNickname ?? \"\",\n        url: videoUrl,\n        metadata: { videoId: vid, commenterId, time, location: fields.location ?? \"\", replyCount: fields.replyCount ?? \"0\" },\n        rawData: fields\n      });\n      savedCount++;\n    }\n  }\n  noProgressScans = added === 0 ? noProgressScans + 1 : 0;\n  if (records.length >= count) { stopReason = \"requested_count\"; break; }\n  const endState = await tobub.atoms.condition({ type: \"text\", selector: \"body\", text: \"暂时没有更多评论\", throwOnTimeout: false }, { timeout: 350 });\n  if (endState.satisfied) { stopReason = \"end_of_list\"; break; }\n  if (noProgressScans >= 3) { stopReason = records.length === 0 ? \"no_comments\" : \"no_progress\"; break; }\n  if (i + 1 < maxScrollTimes) {\n    await tobub.atoms.scroll({ mode: \"viewport\", distance: tobub.utils.randInt(450, 1000), steps: tobub.utils.randInt(4, 10), stepPauseRange: [20, 50] });\n    await tobub.atoms.waitFor([800, 1800]);\n  }\n}\nreturn { videoId: vid, records, savedCount, scans, complete: records.length >= count || stopReason === \"end_of_list\", stopReason };",
    "platform": "douyin",
