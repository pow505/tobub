    "name": "抖音自动点赞助手",
    "skill_version": "1.0.3",
    "source_type": "local",
    "skill_code": "const params = tobub.params || {};\nfunction normalizeVideoId(input) {\n  const value = String(input ?? \"\").trim();\n  if (!value) throw new Error(\"vid 不能为空\");\n  let candidate = value;\n  if (/^https?:\\/\\//i.test(value)) {\n    let parsed;\n    try { parsed = new URL(value); } catch { throw new Error(\"vid 不是有效的视频 ID 或 URL\"); }\n    if (!/(^|\\.)douyin\\.com$/i.test(parsed.hostname)) throw new Error(\"视频 URL 必须来自 douyin.com\");\n    const match = parsed.pathname.match(/\\/video\\/(\\d+)/);\n    if (!match) throw new Error(\"视频 URL 中没有有效的视频 ID\");\n    candidate = match[1];\n  }\n  if (!/^\\d{8,30}$/.test(candidate)) throw new Error(\"视频 ID 必须是 8 到 30 位数字\");\n  return candidate;\n}\nconst vid = normalizeVideoId(params.vid);\nconst probabilityPercent = Number(params.probability ?? 10);\nconst dryRun = params.dryRun !== false;\nconst maxLikes = Number(params.maxLikes ?? 1);\nconst maxScrollTimes = Number(params.maxScrollTimes ?? 10);\nif (!Number.isFinite(probabilityPercent) || probabilityPercent < 0 || probabilityPercent > 100) throw new Error(\"probability 必须是 0 到 100 之间的数字\");\nif (!Number.isInteger(maxLikes) || maxLikes < 0 || maxLikes > 20) throw new Error(\"maxLikes 必须是 0 到 20 的整数\");\nif (!Number.isInteger(maxScrollTimes) || maxScrollTimes < 1 || maxScrollTimes > 50) throw new Error(\"maxScrollTimes 必须是 1 到 50 的整数\");\nconst probability = probabilityPercent / 100;\nconst commentLikeSelector = 'div[data-scroll=\"comment\"] p:has(> svg + span)';\nconst records = [];\nlet checkedCount = 0;\nlet selectedCount = 0;\nlet likedCount = 0;\nlet verifiedCount = 0;\nlet visitedScrolls = 0;\nlet stopReason = \"maxScrollTimes\";\nconst runKey = \"douyin-like-\" + vid + \"-\" + Date.now() + \"-\" + Math.random();\nconst expression = [\n\"({ selector, runKey }) => {\",\n\" const store = window.__tobubLikeSeenByRun ||= new Map();\",\n\" let seen = store.get(runKey);\",\n\" if (!seen) { seen = new WeakSet(); store.set(runKey, seen); }\",\n\" const items = [...document.querySelectorAll(selector)];\",\n\" const width = window.innerWidth, height = window.innerHeight, indices = [];\",\n\" items.forEach((el, index) => {\",\n\"  const rect = el.getBoundingClientRect(), path = el.querySelector('svg path');\",\n\"  const visible = el.getClientRects().length > 0 && getComputedStyle(el).visibility !== 'hidden' && rect.bottom > 0 && rect.top < height && rect.right > 0 && rect.left < width;\",\n\"  const unliked = path?.getAttribute('fill') === '#fff';\",\n\"  if (!visible || !unliked || seen.has(el)) return;\",\n\"  seen.add(el); indices.push(index);\",\n\" });\",\n\" return indices;\",\n\"}\"\n].join(\"\\n\");\nasync function getVisibleUnlikedIndices() {\n  const result = await tobub.atoms.evaluate({ expression, arg: { selector: commentLikeSelector, runKey } });\n  return Array.isArray(result.value) ? result.value : [];\n}\nasync function getLikedState(index) {\n  const verifyExpression = [\n  \"({ selector, index }) => {\",\n  \" const el = document.querySelectorAll(selector)[index];\",\n  \" const path = el?.querySelector('svg path');\",\n  \" return !!path && path.getAttribute('fill') !== '#fff';\",\n  \"}\"\n  ].join(\"\\n\");\n  const result = await tobub.atoms.evaluate({ expression: verifyExpression, arg: { selector: commentLikeSelector, index } });\n  return result.value === true;\n}\nawait tobub.adapter.navigate({ url: \"https://www.douyin.com/video/\" + vid, waitUntil: \"domcontentloaded\" });\nawait tobub.atoms.waitFor({ selector: 'div[data-scroll=\"comment\"]', selectorState: \"attached\" }, { timeout: 20_000 });\nawait tobub.adapter.dismissPopups();\nawait tobub.atoms.waitFor([1500, 2500]);\nfor (let i = 0; i < maxScrollTimes; i++) {\n  if (selectedCount >= maxLikes) { stopReason = \"maxLikes\"; break; }\n  const indices = await getVisibleUnlikedIndices();\n  for (let j = indices.length - 1; j >= 0; j--) {\n    if (selectedCount >= maxLikes) { stopReason = \"maxLikes\"; break; }\n    const index = indices[j];\n    checkedCount++;\n    const selected = tobub.utils.chance(probability);\n    const record = { sequence: checkedCount, domIndex: index, selected, dryRun, clicked: false, verified: false };\n    records.push(record);\n    if (!selected) continue;\n    selectedCount++;\n    if (dryRun) continue;\n    try {\n      await tobub.atoms.click({ selector: commentLikeSelector, nth: index, visibleOnly: true, where: { selector: \"svg path\", source: \"attr\", attr: \"fill\", equals: \"#fff\" } });\n      record.clicked = true;\n      likedCount++;\n      await tobub.atoms.waitFor([150, 300]);\n      record.verified = await getLikedState(index);\n      if (record.verified) verifiedCount++;\n    } catch (error) {\n      record.error = String(error?.message ?? error).slice(0, 240);\n    }\n  }\n  if (selectedCount >= maxLikes) { stopReason = \"maxLikes\"; break; }\n  visitedScrolls++;\n  await tobub.atoms.scroll({ mode: \"viewport\", distance: tobub.utils.randInt(450, 950), steps: tobub.utils.randInt(3, 8), stepPauseRange: [20, 45] });\n  await tobub.atoms.waitFor([700, 1500]);\n  const endCheck = await tobub.atoms.condition({ conditions: [{ type: \"visible\", selector: 'text=\"暂时没有更多评论\"' }, { type: \"inViewport\", selector: 'text=\"暂时没有更多评论\"', intersection: \"partial\" }], mode: \"all\", throwOnTimeout: false }, { timeout: 1200 });\n  if (endCheck.satisfied) { stopReason = \"end_of_comments\"; break; }\n}\nreturn { videoId: vid, dryRun, visitedScrolls, checkedCount, selectedCount, likedCount, verifiedCount, records, stopReason };",
    "platform": "douyin",
