  "skill": {
    "market_skill_id": "douyin-get-user-info",
    "release_id": "douyin-get-user-info-1.0.4",
    "name": "抖音获取用户信息",
    "skill_version": "1.0.4",
    "source_type": "local",
    "skill_code": "const params = tobub.params || {};\nfunction normalizeUserId(input) {\n  const value = String(input ?? \"\").trim();\n  if (!value) throw new Error(\"uid 不能为空\");\n  if (/^https?:\\/\\//i.test(value)) {\n    let parsed;\n    try { parsed = new URL(value); } catch { throw new Error(\"uid 不是有效的抖音用户 ID 或主页 URL\"); }\n    if (!/(^|\\.)douyin\\.com$/i.test(parsed.hostname)) throw new Error(\"用户主页 URL 必须来自 douyin.com\");\n    const parts = parsed.pathname.split(\"/\").filter(Boolean);\n    const index = parts.indexOf(\"user\");\n    if (index < 0 || !parts[index + 1]) throw new Error(\"用户主页 URL 中没有有效的用户 ID\");\n    return decodeURIComponent(parts[index + 1]);\n  }\n  const clean = value.replace(/^@/, \"\");\n  if (clean.length > 128 || /[/?#\\s]/.test(clean)) throw new Error(\"uid 格式无效\");\n  return clean;\n}\nconst uid = normalizeUserId(params.uid);\nconst saveResults = params.saveResults !== false;\nconst profileUrl = \"https://www.douyin.com/user/\" + encodeURIComponent(uid);\nawait tobub.adapter.navigate({ url: profileUrl, waitUntil: \"domcontentloaded\" });\nawait tobub.atoms.waitFor({ title: \"的抖音\", titleMatch: \"contains\" }, { timeout: 20_000 });\nawait tobub.adapter.dismissPopups();\nawait tobub.atoms.waitFor({ selector: \"#user_detail_element\", selectorState: \"attached\" }, { timeout: 15_000 });\nconst location = await tobub.adapter.getCurrentLocation();\nconst user = await tobub.atoms.extractItem({\n  selector: \"#user_detail_element\",\n  fields: [\n    { name: \"avatarUrl\", selector: 'span[data-e2e=\"live-avatar\"] img', source: \"src\" },\n    { name: \"avatarCandidates\", selector: \"img\", source: \"src\", many: true },\n    { name: \"nickname\", selector: 'div[data-e2e=\"user-info\"] h1', source: \"text\" },\n    { name: \"followText\", selector: '[data-e2e=\"user-info-follow\"]', source: \"text\" },\n    { name: \"fansText\", selector: '[data-e2e=\"user-info-fans\"]', source: \"text\" },\n    { name: \"likeText\", selector: '[data-e2e=\"user-info-like\"]', source: \"text\" },\n    { name: \"douyinId\", selector: 'span:has-text(\"抖音号：\")', source: \"text\", transforms: [{ type: \"match\", pattern: { pattern: \"抖音号：(.+)\" } }] },\n    { name: \"ipLocation\", selector: 'span:has-text(\"IP属地：\")', source: \"text\", transforms: [{ type: \"match\", pattern: { pattern: \"IP属地：(.+)\" } }] },\n    { name: \"remark\", selector: 'div[data-e2e=\"user-info\"] > div:last-child', source: \"text\" },\n    { name: \"works\", selector: 'div#user-tabbar span[data-e2e=\"user-tab-count\"]', source: \"textContent\" }\n  ]\n});\nconst avatarCandidates = Array.isArray(user.avatarCandidates) ? user.avatarCandidates.filter((value) => typeof value === \"string\" && /^https?:\\/\\//i.test(value)) : [];\nif (!user.avatarUrl) user.avatarUrl = avatarCandidates.find((value) => /avatar/i.test(value)) ?? avatarCandidates[0] ?? null;\ndelete user.avatarCandidates;\nconst userUrl = location.url || profileUrl;\nif (saveResults) {\n  await tobub.db.saveContent({ platform: \"douyin\", contentType: \"user\", externalId: uid, title: user.nickname ?? uid, summary: user.remark ?? \"\", url: userUrl, metadata: { ...user, uid }, rawData: user });\n}\nreturn { user: { ...user, uid, url: userUrl }, saved: saveResults };",
    "platform": "douyin",
