    "release_id": "douyin-search-videos-1.0.4",
    "name": "抖音获取搜索结果",
    "skill_version": "1.0.4",
    "source_type": "local",
    "skill_code": "const params = tobub.params || {};\nconst searchKey = String(params.searchKey ?? \"\").trim();\nconst count = Number(params.count ?? 10);\nconst maxScrollTimes = Number(params.maxScrollTimes ?? 12);\nconst saveResults = params.saveResults !== false;\nif (!searchKey || searchKey.length > 100) throw new Error(\"searchKey 不能为空且不能超过 100 个字符\");\nif (!Number.isInteger(count) || count < 1 || count > 100) throw new Error(\"count 必须是 1 到 100 的整数\");\nif (!Number.isInteger(maxScrollTimes) || maxScrollTimes < 1 || maxScrollTimes > 50) throw new Error(\"maxScrollTimes 必须是 1 到 50 的整数\");\nconst records = [];\nconst seen = new Set();\nconst warnings = [];\nlet scans = 0;\nlet savedCount = 0;\nlet noProgressScans = 0;\nlet stopReason = \"maxScrollTimes\";\nawait tobub.atoms.navigate({ url: \"https://www.douyin.com/search/\" + encodeURIComponent(searchKey) + \"?type=general\", waitUntil: \"domcontentloaded\" });\nawait tobub.atoms.waitFor({ title: \"抖音搜索\", titleMatch: \"contains\" }, { timeout: 20_000 });\nawait tobub.adapter.dismissPopups();\nawait tobub.atoms.waitFor([2000, 4000]);\ntry {\n  await tobub.atoms.click({ selector: 'div#search-toolbar-container div:text-is(\"多列\")' }, { timeout: 2500 });\n} catch (error) {\n  warnings.push(\"当前搜索布局没有可用的“多列”切换控件，继续使用页面默认布局。\");\n}\nfor (let i = 0; i < maxScrollTimes && records.length < count; i++) {\n  scans++;\n  const ready = await tobub.atoms.condition({ type: \"count\", selector: \"div#waterFallScrollContainer > div\", comparison: \"gte\", value: 1, pollInterval: 200, throwOnTimeout: false }, { timeout: 2500 });\n  if (ready.satisfied) {\n    const videoList = await tobub.adapter.extract(\"search_videos\", { scan: { mode: \"append\" } });\n    let added = 0;\n    for (const record of videoList?.records ?? []) {\n      if (records.length >= count) break;\n      const fields = record.fields ?? {};\n      const externalId = String(record.id || fields.vid || \"\");\n      if (!externalId || seen.has(externalId)) continue;\n      seen.add(externalId);\n      records.push(record);\n      added++;\n      if (saveResults) {\n        await tobub.db.saveContent({\n          platform: \"douyin\",\n          contentType: \"video\",\n          externalId,\n          title: fields.intro ?? \"抖音视频 \" + externalId,\n          summary: fields.author ?? \"\",\n          url: \"https://www.douyin.com/video/\" + externalId,\n          metadata: { thumb: fields.thumb ?? \"\", duration: fields.duration ?? \"\", like: fields.like ?? \"\", author: fields.author ?? \"\", time: fields.time ?? \"\" },\n          rawData: fields\n        });\n        savedCount++;\n      }\n    }\n    noProgressScans = added === 0 ? noProgressScans + 1 : 0;\n  } else {\n    noProgressScans++;\n  }\n  if (records.length >= count) { stopReason = \"requested_count\"; break; }\n  if (noProgressScans >= 3) { stopReason = records.length === 0 ? \"no_results\" : \"no_progress\"; break; }\n  if (i + 1 < maxScrollTimes) {\n    await tobub.atoms.scroll({ mode: \"viewport\", distance: tobub.utils.randInt(500, 1100), steps: tobub.utils.randInt(4, 10), stepPauseRange: [20, 50] });\n    await tobub.atoms.waitFor([1000, 2200]);\n  }\n}\nreturn { query: searchKey, records, scans, savedCount, complete: records.length >= count, stopReason, warnings };",
    "platform": "douyin",
