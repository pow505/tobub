    "name": "抖音自动化浏览视频",
    "skill_version": "1.0.4",
    "source_type": "local",
    "skill_code": "const params = tobub.params || {};\nconst minutes = Number(params.minutes ?? 5);\nconst maxScrollTimes = Number(params.maxScrollTimes ?? 100);\nconst maxRecords = Number(params.maxRecords ?? 100);\nconst saveResults = params.saveResults !== false;\nif (!Number.isFinite(minutes) || minutes < 0.1 || minutes > 60) throw new Error(\"minutes 必须在 0.1 到 60 之间\");\nif (!Number.isInteger(maxScrollTimes) || maxScrollTimes < 1 || maxScrollTimes > 500) throw new Error(\"maxScrollTimes 必须是 1 到 500 的整数\");\nif (!Number.isInteger(maxRecords) || maxRecords < 1 || maxRecords > 500) throw new Error(\"maxRecords 必须是 1 到 500 的整数\");\nconst records = [];\nconst seen = new Set();\nconst errors = [];\nlet visitedCount = 0;\nlet savedCount = 0;\nlet errorCount = 0;\nlet consecutiveErrors = 0;\nlet stopReason = \"duration_elapsed\";\nawait tobub.adapter.bootstrap();\nawait tobub.adapter.dismissPopups();\nawait tobub.adapter.navigate({ name: \"recommend\" });\nconst deadline = Date.now() + Math.round(minutes * 60_000);\nfor (let i = 0; i < maxScrollTimes && Date.now() < deadline && records.length < maxRecords; i++) {\n  try {\n    await tobub.adapter.dismissPopups();\n    if (tobub.utils.chance(0.05)) {\n      await tobub.atoms.refresh({ waitUntil: \"domcontentloaded\" });\n      await tobub.adapter.navigate({ name: \"recommend\" });\n    }\n    await tobub.atoms.swipeVideo({ mode: \"wheel\", target: { selector: \".parent-route-container.route-scroll-container\" } });\n    visitedCount++;\n    const dataList = await tobub.adapter.extract(\"content_info\");\n    const record = dataList?.records?.find((item) => item && (item.id || item.fields?.vid));\n    if (record) {\n      const fields = record.fields ?? {};\n      const externalId = String(record.id || fields.vid || \"\");\n      if (externalId && !seen.has(externalId)) {\n        seen.add(externalId);\n        records.push(record);\n        if (saveResults) {\n          await tobub.db.saveContent({\n            platform: \"douyin\",\n            contentType: \"video\",\n            externalId,\n            title: fields.intro ?? \"抖音视频 \" + externalId,\n            summary: fields.author ?? \"\",\n            url: \"https://www.douyin.com/video/\" + externalId,\n            metadata: { author: fields.author ?? \"\", time: fields.time ?? \"\", like: fields.like ?? \"\", comment: fields.comment ?? \"\", collect: fields.collect ?? \"\", share: fields.share ?? \"\", uid: fields.uid ?? \"\" },\n            rawData: fields\n          });\n          savedCount++;\n        }\n      }\n    }\n    consecutiveErrors = 0;\n  } catch (error) {\n    consecutiveErrors++;\n    errorCount++;\n    if (errors.length < 10) errors.push(String(error?.message ?? error).slice(0, 300));\n    if (consecutiveErrors >= 3) { stopReason = \"repeated_errors\"; break; }\n  }\n  const remainingMs = deadline - Date.now();\n  if (remainingMs > 0) {\n    const high = Math.min(10_000, remainingMs);\n    const low = Math.min(5_000, high);\n    await tobub.atoms.waitFor([low, high]);\n  }\n}\nif (records.length >= maxRecords) stopReason = \"maxRecords\";\nelse if (visitedCount >= maxScrollTimes && Date.now() < deadline) stopReason = \"maxScrollTimes\";\nelse if (Date.now() >= deadline) stopReason = \"duration_elapsed\";\nreturn { records, visitedCount, savedCount, errorCount, errors, complete: errorCount === 0 && (stopReason === \"duration_elapsed\" || stopReason === \"maxRecords\"), stopReason };",
    "platform": "douyin",
