  "rule": {
    "platform": "tiktok",
    "version": "1.0.0",
    "schema_version": "1",
    "hash": "40d120c6ebe535013e9d6998eb40fb702b236032e08be41284f2c0b65dcd11eb",
    "rules": {
      "actions": {
        "discoverScroll": {
          "steps": [
            {
              "atom": "dismiss",
              "options": {
                "target": "${selectors.closeAll}"
              }
            },
            {
              "atom": "scroll",
              "options": {
                "distance": [
                  700,
                  1200
                ],
                "mode": "mouse",
                "stepPauseRange": [
                  10,
                  25
                ],
                "steps": [
                  8,
                  15
                ],
                "target": "${selectors.discoverContainer}"
              }
            },
            {
              "atom": "waitFor",
              "options": {
                "delay": [
                  3000,
                  10000
                ]
              }
            }
          ]
        },
        "discoverWarmup": {
          "steps": [
            {
              "action": "discoverScroll",
              "repeat": {
                "max": 12,
                "min": 5
              }
            }
          ]
        },
        "pageReady": {
          "steps": [
            {
              "atom": "waitFor",
              "options": {
                "title": "TikTok",
                "titleMatch": "contains"
              },
              "timeout": 5000
            },
            {
              "atom": "waitFor",
              "options": {
                "delay": [
                  2000,
                  3500
                ]
              }
            },
            {
              "atom": "waitFor",
              "options": {
                "delay": [
                  10000,
                  15500
                ],
                "selector": "${selectors.showMenu}"
              },
              "timeout": 10000
            }
          ]
        },
        "shortsScroll": {
          "steps": [
            {
              "atom": "dismiss",
              "options": {
                "target": "${selectors.closeAll}"
              }
            },
            {
              "atom": "scroll",
              "options": {
                "distance": [
                  600,
                  1000
                ],
                "mode": "mouse",
                "steps": [
                  1,
                  3
                ],
                "target": "${selectors.showVideo}"
              }
            },
            {
              "atom": "waitFor",
              "options": {
                "delay": [
                  3000,
                  5000
                ]
              }
            }
          ]
        },
        "watchReady": {
          "steps": [
            {
              "atom": "waitFor",
              "options": {
                "delay": [
                  2000,
                  3500
                ],
                "selector": "${selectors.showVideo}",
                "selectorState": "visible"
              },
              "timeout": 10000
            }
          ]
        },
        "watchShort": {
          "steps": [
            {
              "action": "shortsScroll"
            },
            {
              "atom": "waitFor",
              "options": {
                "delay": [
                  30000,
                  50000
                ]
              },
              "probability": 0.05
            }
          ]
        }
      },
      "extractors": {},
      "meta": {
        "baseUrl": "https://www.tiktok.com",
        "capabilities": [],
        "name": "TikTok"
      },
      "platform": "tiktok",
      "routes": {
        "discover": {
          "locator": "a[data-e2e=\"nav-explore\"]"
        },
        "home": {
          "locator": "a[data-e2e=\"nav-foryou\"]",
          "url": "https://www.tiktok.com"
        }
      },
      "selectors": {
        "closeAll": [
          "div[data-e2e=\"modal-close-inner-button\"]",
          "div[class*='DivCloseButtonWrapper']",
          "div[role=\"button\"][tabindex=\"0\"]:text-is(\"Skip\")"
        ],
        "discoverContainer": "div#main-content-explore_page",
        "showMenu": "div[class*='DivMainNavContainer']",
        "showVideo": "div#column-list-container"
      },
      "version": "1.0.0"
    }
  }
}
