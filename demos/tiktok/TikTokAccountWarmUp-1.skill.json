  "skill": {
    "market_skill_id": "user_1785644546305_gad5yp",
    "release_id": "user_1785644546305_gad5yp",
    "name": "TikTokAccountWarmUp",
    "skill_version": "1.0.3",
    "source_type": "local",
    "skill_code": "const minutes = Number(tobub.params.minutes ?? 5);\nconst times = Number(tobub.params.times ?? 5);\nconst discoverProbability = Number(tobub.params.discoverProbability ?? 0);\nif (!Number.isInteger(minutes) || minutes < 1 || minutes > 30) throw new Error('minutes must be an integer from 1 to 30.');\nif (!Number.isInteger(times) || times < 1 || times > 30) throw new Error('times must be an integer from 1 to 30.');\nif (!Number.isFinite(discoverProbability) || discoverProbability < 0 || discoverProbability > 100) throw new Error('discoverProbability must be between 0 and 100.');\n\nconst startedAt = Date.now();\nconst deadline = startedAt + minutes * 60 * 1000;\nlet cycles = 0;\nlet watchedCycles = 0;\nlet discoverCycles = 0;\nawait tobub.adapter.bootstrap();\nawait tobub.adapter.action('pageReady');\n\nwhile (Date.now() < deadline && cycles < times) {\n  const useDiscover = discoverProbability > 0 && Math.random() * 100 < discoverProbability;\n  if (useDiscover) {\n    await tobub.adapter.navigate({ name: 'discover' });\n    await tobub.adapter.action('discoverWarmup');\n    discoverCycles++;\n  } else {\n    await tobub.adapter.navigate({ name: 'home' });\n    await tobub.adapter.action('watchReady');\n    if (Date.now() < deadline) {\n      await tobub.adapter.action('watchShort');\n      watchedCycles++;\n    }\n  }\n  cycles++;\n}\nconst durationSeconds = Math.round((Date.now() - startedAt) / 1000);\nconst timeLimitReached = Date.now() >= deadline;\nreturn {\n  requestedMinutes: minutes,\n  maxCycles: times,\n  cycles,\n  watchedCycles,\n  discoverCycles,\n  durationSeconds,\n  timeLimitReached,\n  warning: durationSeconds > minutes * 60 + 60 ? 'Browsing stops after the current page action completes, so the run may exceed the time limit slightly.' : ''\n};",
    "platform": "tiktok",
    "input_schema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "minutes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "title": "Runtime limit (minutes)",
          "description": "Maximum runtime. The current browsing action finishes before the Skill stops."
        },
        "times": {
          "type": "integer",
          "minimum": 1,
          "maximum": 30,
          "title": "Maximum browsing rounds",
          "description": "The Skill stops when either the runtime or round limit is reached."
        },
        "discoverProbability": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "title": "Discovery page probability (%)",
          "description": "0 browses only the For You feed; 100 switches to the Discover page every round."
        }
      },
      "required": []
    },
