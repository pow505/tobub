    "source_type": "local",
    "skill_code": "// Code Tab\nawait tobub.adapter.navigateTo('trending', { waitUntil: 'domcontentloaded' });\n//\nconst result = await tobub.adapter.extractData('trending_list');\n\nfor (const record of result.records) {\n  // if (allRecordIds.has(record.id)) continue\n\n  await tobub.db.saveContent({\n    platform: 'github',\n    contentType: 'Repositories',\n    externalId: record.id,\n    title: record.fields.title,\n    summary: record.fields.description,\n    url: record.fields.url\n      ? 'https://www.github.com/' + record.id\n      : '',\n    metadata: record.fields ?? {},\n    rawData: {},\n  })\n}\n\nreturn result;\n// await tobub.atoms.pause();",
