    "rules": {
      "platform": "github",
      "version": "local-dev",
      "meta": {
        "name": "github",
        "baseUrl": "https://www.github.com",
        "capabilities": []
      },
      "routes": {
        "home": {
          "locator": "a#github-logo",
          "url": "https://www.github.com"
        },
        "trending": {
          "url": "https://www.github.com/trending?since=daily"
        }
      },
      "extractors": {
        "trending_list": {
          "itemSelector": "article.Box-row",
          "idField": "id",
          "fields": [
            {
              "name": "id",
              "selector": "h2 a",
              "source": "text",
              "transforms": [
                {
                  "type": "trim"
                },
                {
                  "type": "replace",
                  "pattern": "\\s*/\\s*",
                  "replacement": "/"
                }
              ]
            },
            {
              "name": "title",
              "selector": "h2 a",
              "source": "text",
              "transforms": [
                {
                  "type": "trim"
                }
              ]
            },
            {
              "name": "description",
              "selector": "p",
              "source": "text"
            },
            {
              "name": "language",
              "selector": "span[itemprop=\"programmingLanguage\"]",
              "source": "text"
            },
            {
              "name": "stars",
              "selector": "a[href$=\"/stargazers\"]",
              "source": "text"
            },
            {
              "name": "forks",
              "selector": "a[href$=\"/forks\"]",
              "source": "text"
            },
            {
              "name": "starsToday",
              "selector": "span.d-inline-block.float-sm-right",
              "source": "text",
              "match": "(\\d+)",
              "fallback": "0"
            }
          ]
        }
      },
      "selectors": {},
      "actions": {}
    }
