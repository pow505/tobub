    "source_type": "local",
    "skill_code": "// Code Tab\nawait tobub.adapter.bootstrap()\n\nawait tobub.atoms.waitFor({ timeout: 30000 })\n\ntry {\n  await tobub.atoms.click({ selector: 'button.a-button-text' })\n} catch {}\n\nawait tobub.atoms.click({\n  selector: 'form#nav-search-bar-form input#twotabsearchtextbox',\n  timeout: 30000,\n})\n\nawait tobub.atoms.fill({\n  selector: 'form#nav-search-bar-form input#twotabsearchtextbox',\n  value: 'nike',\n  timeout: 30000,\n})\n\nawait tobub.atoms.press({ key: 'Enter' })\n\nawait tobub.atoms.waitFor({ delay: [3000, 5600] })\n\nfor (let i = 0; i < 999; i++) {\n  await tobub.adapter.action('searchScroll')\n\n  try {\n    await tobub.atoms.waitFor({\n      selector: 'div[role=\"navigation\"]',\n      selectorState: 'visible',\n      timeout: 5000,\n    })\n\n    await tobub.atoms.click({\n      selector: 'a.s-pagination-next',\n      timeout:10000\n    })\n\n    break\n  } catch {\n    // 目标元素未出现，继续滚动\n  }\n}\n\nawait tobub.debug.pause()\n",
