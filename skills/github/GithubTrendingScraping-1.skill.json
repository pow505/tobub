    "rules": {
      "actions": {},
      "extractors": {
        "trending_list": {
          "fields": [
            {
              "name": "id",
              "selector": "h2 a",
              "source": "text",
              "transforms": [
                {
                  "type": "trim"
                },
                {
                  "pattern": "\\s*/\\s*",
                  "replacement": "/",
                  "type": "replace"
                }
              ]
            },
            {
              "name": "title",
              "selector": "h2 a",
              "source": "text",
              "transforms": [
                {
                  "type": "trim"
                }
              ]
            },
            {
              "name": "description",
              "selector": "p",
              "source": "text"
            },
            {
              "name": "language",
              "selector": "span[itemprop=\"programmingLanguage\"]",
              "source": "text"
            },
            {
              "name": "stars",
              "selector": "a[href$=\"/stargazers\"]",
              "source": "text"
            },
            {
              "name": "forks",
              "selector": "a[href$=\"/forks\"]",
              "source": "text"
            },
            {
              "fallback": "0",
              "match": "(\\d+)",
              "name": "starsToday",
              "selector": "span.d-inline-block.float-sm-right",
              "source": "text"
            }
          ],
          "idField": "id",
          "itemSelector": "article.Box-row"
        }
      },
