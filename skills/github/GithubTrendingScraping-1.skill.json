    "name": "GithubTrendingScraping",
    "source_type": "local",
    "skill_code": "await tobub.adapter.navigate('trending', {  sort: tobub.params.sort});\nconst result = await tobub.adapter.extract('trending_list');\n\nfor (const record of result.records) {\n\n  await tobub.db.saveContent({\n    platform: 'github',\n    contentType: 'Repositories',\n    externalId: record.id,\n    title: record.fields.title,\n    summary: record.fields.description,\n    url: record.fields.url\n      ? 'https://www.github.com/' + record.id\n      : '',\n    metadata: record.fields ?? {},\n    rawData: {},\n  })\n}\n\nreturn result;",
    "platform": "github",
    "input_schema": {
      "type": "object",
      "properties": {
        "sort": {
          "title": "sort",
          "type": "string",
          "enum": [
            "daily",
            "weekly",
            "monthly"
          ]
        }
      },
      "additionalProperties": true
    },
    "output_schema": {},
    "ui_schema": {
      "version": 1,
      "fields": [
        {
          "default": "daily",
          "key": "sort",
          "label": "sort",
          "options": [
            {
              "label": "daily",
              "value": "daily"
            },
            {
              "label": "weekly",
              "value": "weekly"
            },
            {
              "label": "monthly",
              "value": "monthly"
            }
          ],
          "required": false,
          "type": "select"
        }
      ]
    },
    "requirements": {},
    "defaults": {
      "params": {
        "sort": "daily"
      },
      "browser": {
        "headless": false
      },
      "execution": {
        "domain_mode": "optional"
      }
    },
    "metadata": {}
  },
